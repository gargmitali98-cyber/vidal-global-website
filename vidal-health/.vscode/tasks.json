{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Dev Server on 6001",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "npm run dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
